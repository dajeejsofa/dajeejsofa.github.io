---
import { business, returnPolicy } from '../data/business';

export interface Props {
  faqs?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
  product?: { name: string; url: string; image?: string; description?: string; price?: number; inStock: boolean; perMeter?: boolean };
  service?: { name: string; url: string; description?: string; price?: number };
  lang?: 'ar' | 'en';
}
const { faqs = [], breadcrumbs = [], product, service, lang = 'ar' } = Astro.props;
const isEn = lang === 'en';
const site = Astro.site!.toString().replace(/\/$/, '');
const storeId = `${site}/#store`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'FurnitureStore',
    '@id': storeId,
    name: business.name,
    alternateName: business.nameEn,
    description: isEn ? business.descriptionEn : business.description,
    url: `${site}/`,
    logo: `${site}/icon-512.png`,
    image: `${site}/og-image.jpg`,
    telephone: `+965${business.phone}`,
    currenciesAccepted: 'KWD',
    hasMerchantReturnPolicy: returnPolicy.schema,
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.unit ? `${business.unit}، ${business.street}` : business.street,
      addressLocality: business.locality,
      addressCountry: business.countryCode,
    },
    areaServed: { '@type': 'Country', name: 'Kuwait' },
    ...(business.geo ? { geo: { '@type': 'GeoCoordinates', ...business.geo } } : {}),
    ...(business.mapUrl ? { hasMap: business.mapUrl } : {}),
    ...(business.openingHours.length ? { openingHours: business.openingHours } : {}),
    ...(business.sameAs.length ? { sameAs: business.sameAs } : {}),
  },
  { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: business.name, inLanguage: ['ar-KW', 'en'], publisher: { '@id': storeId } },
];

if (breadcrumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: b.url })),
  });
}
if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}
if (product) {
  graph.push({
    '@type': 'Product',
    name: product.name,
    url: product.url,
    ...(product.image ? { image: product.image } : {}),
    ...(product.description ? { description: product.description } : {}),
    brand: { '@type': 'Brand', name: business.name },
    ...(typeof product.price === 'number' && product.price > 0
      ? {
          offers: {
            '@type': 'Offer',
            url: product.url,
            price: product.price.toFixed(3),
            priceCurrency: 'KWD',
            ...(product.perMeter
              ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: product.price.toFixed(3), priceCurrency: 'KWD', unitCode: 'MTR', unitText: 'متر طولي' } }
              : {}),
            // التوفر: الجاهز في المعرض InStock، والتفصيل حسب الطلب MadeToOrder (قيمة يقبلها جوجل وتطابق الواقع)
            availability: product.inStock ? 'https://schema.org/InStock' : 'https://schema.org/MadeToOrder',
            hasMerchantReturnPolicy: returnPolicy.schema,
            seller: { '@id': storeId },
          },
        }
      : {}),
  });
}
if (service) {
  graph.push({
    '@type': 'Service',
    name: service.name,
    url: service.url,
    ...(service.description ? { description: service.description } : {}),
    provider: { '@id': storeId },
    areaServed: { '@type': 'Country', name: 'Kuwait' },
    // سعر الخدمة بالمتر الطولي شامل القماش — رقم صريح تقتبسه محركات الذكاء الاصطناعي
    ...(typeof service.price === 'number' && service.price > 0
      ? {
          offers: {
            '@type': 'Offer',
            priceCurrency: 'KWD',
            priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: service.price.toFixed(3), priceCurrency: 'KWD', unitCode: 'MTR', unitText: isEn ? 'linear metre, fabric included' : 'متر طولي شامل القماش' },
            seller: { '@id': storeId },
          },
        }
      : {}),
  });
}
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<script type="application/ld+json" set:html={json} />
