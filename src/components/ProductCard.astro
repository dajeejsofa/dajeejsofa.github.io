---
import { Image } from 'astro:assets';
import type { Product } from '../lib/catalog';
import { productUrl, productImages, productAlt } from '../lib/catalog';
import { formatKWD, unitLabel } from '../lib/price';
export interface Props { product: Product; eager?: boolean }
const { product, eager = false } = Astro.props;
const { title, price, priceNote, priceUnit } = product.data;
const image = productImages(product)[0];
const imageAlt = productAlt(product);
---
<a href={productUrl(product)} class="group block overflow-hidden rounded-xl border border-line bg-white">
  <div class="aspect-[4/3] bg-sand">
    {image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={[360, 560, 800]}
        sizes="(min-width: 1024px) 25vw, 50vw"
        class="h-full w-full object-cover"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    )}
  </div>
  <div class="p-3 sm:p-4">
    <h3 class="line-clamp-2 text-sm font-semibold leading-snug group-hover:text-accent sm:text-base">{title}</h3>
    {typeof price === 'number' && price > 0
      ? <p class="mt-1 text-sm font-bold sm:text-base">{formatKWD(price)}<span class="text-xs font-normal text-muted sm:text-sm">{unitLabel(priceUnit)}</span></p>
      : <p class="mt-1 text-sm text-muted">{priceNote || 'السعر عبر واتساب'}</p>}
  </div>
</a>
