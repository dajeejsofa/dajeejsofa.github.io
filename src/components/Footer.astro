---
import { business, fullAddress, services } from '../data/business';
import { waGeneral } from '../data/whatsapp';
import { categoriesWithProducts } from '../lib/catalog';
const cats = await categoriesWithProducts();
const year = new Date().getFullYear();
---
<footer class="mt-16 border-t border-line bg-white text-sm">
  <div class="container-page grid gap-8 py-10 md:grid-cols-3">
    <div>
      <a href="/" class="text-base font-bold">{business.name}</a>
      <p class="mt-2 text-muted">{business.description}</p>
    </div>
    <div>
      <p class="font-bold">الخدمات والأقسام</p>
      <ul class="mt-2 space-y-1">
        {services.map((s) => <li><a class="hover:text-accent" href={`/${s.slug}/`}>{s.title}</a></li>)}
        {cats.map((c) => <li><a class="hover:text-accent" href={`/${c.id}/`}>{c.data.title}</a></li>)}
        <li><a class="hover:text-accent" href="/shop/">كل المنتجات</a></li>
      </ul>
    </div>
    <address class="not-italic">
      <p class="font-bold">العنوان والتواصل</p>
      <p class="mt-2"><a class="hover:text-accent" href="/maarad-dajeej/">{fullAddress}</a></p>
      {business.openingHoursText && <p class="mt-1">{business.openingHoursText}</p>}
      <p class="mt-1">
        الهاتف وواتساب: <a dir="ltr" class="font-semibold" href={`tel:+965${business.phone}`}>{business.phone}</a>
      </p>
      <a class="btn btn-wa mt-3 px-4 py-2" href={waGeneral()} target="_blank" rel="noopener">راسلنا على واتساب</a>
    </address>
  </div>
  <div class="border-t border-line py-4 text-center text-muted">© {year} {business.name}</div>
</footer>
