---
// الرئيسية الإنجليزية: تقابل الرئيسية العربية وتُربط بها بـ hreflang في الاتجاهين
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { business, fullAddressEn } from '../../data/business';
import { hoursEn } from '../../data/en';
import { waLink } from '../../data/whatsapp';
import { Image } from 'astro:assets';
import ProductCardEn from '../../components/ProductCardEn.astro';
import { productsForService, priceTextEn, priceFrom, productImages } from '../../lib/catalog';
import { liveEnPages, productsOf, enProducts, enProductsOf } from '../../lib/en';

const tafseel = await productsForService('tafseel-kanab');
const tanjeed = await productsForService('tanjeed-kanab');
const pages = await liveEnPages();
const services = pages.filter((p) => p.kind === 'service');
const cats = pages.filter((p) => p.kind === 'category');
const svcPrice = await Promise.all(services.map(async (p) => (p.ar === 'tasleeh-kanab' ? '' : priceTextEn(await productsOf(p)))));
const hours = hoursEn(business.openingHours);
const all = await enProducts();
const latest = all.slice(0, 8);
const hero = all.find((p) => productImages(p).length > 0);
const catCards = await Promise.all(
  cats.map(async (p) => {
    const list = await enProductsOf(p);
    const withImg = list.find((x) => productImages(x).length > 0);
    return { ...p, count: list.length, from: priceFrom(list), image: withImg ? productImages(withImg)[0] : undefined, alt: withImg?.data.titleEn ?? p.name };
  }),
);
const wa = waLink(`Hello ${business.nameEn}, I have a question about sofas.`);
const faqs = [
  { question: 'What types of sofas do you make?', answer: `${cats.map((p) => p.name).join(', ')}. All are made to measure and priced per linear metre with the fabric included.` },
  { question: `Where is ${business.nameEn} located?`, answer: `Our showroom and workshop are in ${fullAddressEn}.${hours ? ` ${hours}.` : ''}` },
  { question: 'How much does a custom sofa cost in Kuwait?', answer: `Custom sofas are priced per linear metre with the fabric included, ${priceTextEn(tafseel)} depending on the design. Single armchairs are priced on agreement.` },
  { question: 'How much does sofa upholstery cost?', answer: `Fabric sofa upholstery is ${priceTextEn(tanjeed)} per linear metre of sofa, fabric included, done in our workshop.` },
  { question: 'What does your sofa repair cover?', answer: 'We repair or replace sofa legs, and repair or replace the foam, in our workshop.' },
  { question: 'How do I order?', answer: `Send the design and your wall measurements on WhatsApp ${business.phone}. Orders are by WhatsApp only, and prices are in Kuwaiti dinars.` },
];
---
<BaseLayout
  lang="en"
  alternate="/"
  title={`Sofas in Kuwait — Custom Sofas, Upholstery & Repair | ${business.nameEn}`}
  description={`Sofa showroom and workshop in Katara Complex, Al Dajeej, Kuwait: custom sofas made to measure ${priceTextEn(tafseel, true)} and fabric upholstery ${priceTextEn(tanjeed, true)}, fabric included, plus sofa leg and foam repair. WhatsApp ${business.phone}.`}
  faqs={faqs}
>
  <section class="container-page pt-4 md:pt-8">
    <div class="hero relative overflow-hidden rounded-2xl bg-ink">
      {hero && (
        <Image src={productImages(hero)[0]} alt={hero.data.titleEn!} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1152px) 1120px, 100vw" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
      )}
      <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex h-full flex-col justify-end p-5 md:p-10">
        <h1 class="max-w-3xl text-3xl font-bold leading-snug text-white text-balance md:text-4xl">Sofas in Kuwait: custom sofas, upholstery and repair from our Al Dajeej workshop</h1>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">Order on WhatsApp</a>
          <a class="btn btn-light" href="/en/sofas/">Browse all sofas</a>
        </div>
      </div>
    </div>
    <p class="mt-5 max-w-3xl text-muted">{business.descriptionEn}</p>
  </section>

  {catCards.length > 0 && (
    <section class="container-page mt-10">
      <h2 class="text-2xl font-bold">Sofa types we make</h2>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
        {catCards.map((c) => (
          <a href={`/en/${c.slug}/`} class="group block overflow-hidden rounded-xl border border-line bg-white">
            <div class="aspect-[4/3] bg-sand">
              {c.image && <Image src={c.image} alt={c.alt} widths={[360, 560, 800]} sizes="(min-width: 1024px) 25vw, 50vw" class="h-full w-full object-cover" loading="lazy" />}
            </div>
            <div class="p-3 sm:p-4">
              <h3 class="text-sm font-semibold group-hover:text-accent sm:text-base">{c.name}</h3>
              <p class="mt-1 text-xs text-muted sm:text-sm">{c.count} {c.count === 1 ? 'design' : 'designs'}{c.from ? ` · from ${c.from} KWD/m` : ''}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="container-page mt-12">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold">Latest sofas from our workshop</h2>
        <a class="text-sm underline underline-offset-4" href="/en/sofas/">All sofas</a>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
        {latest.map((p) => <ProductCardEn product={p} />)}
      </div>
    </section>
  )}

  <section class="container-page mt-14">
    <h2 class="text-2xl font-bold">Our services</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((p, i) => (
        <li class="rounded-xl border border-line bg-white p-5">
          <a href={`/en/${p.slug}/`} class="font-bold hover:text-accent">{p.name}</a>
          <p class="mt-1 text-sm text-muted">{svcPrice[i] ? `${svcPrice[i]}, fabric included. ` : ''}{p.intro.split('. ')[0].replace(/\.$/, '')}.</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page mt-14">
    <div class="rounded-xl border border-line bg-white p-6">
      <h2 class="text-2xl font-bold">Visit the showroom</h2>
      <p class="mt-2">{fullAddressEn}</p>
      {hours && <p class="mt-1">{hours}</p>}
      <p class="mt-1">Phone & WhatsApp: <a class="font-semibold" href={`tel:+965${business.phone}`}>{business.phone}</a></p>
      {business.mapUrl && <a class="mt-3 inline-block underline" href={business.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>}
    </div>
  </section>

  <div class="container-page"><FAQ faqs={faqs} title="Frequently asked questions" /></div>
</BaseLayout>
