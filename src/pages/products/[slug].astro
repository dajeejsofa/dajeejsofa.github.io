---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getEntry } from 'astro:content';
import { publishedProducts, productUrl, productImages, productAlt, type Product } from '../../lib/catalog';
import { formatKWD, unitLabel } from '../../lib/price';
import { waProduct } from '../../data/whatsapp';
import { business } from '../../data/business';

export async function getStaticPaths() {
  const products = await publishedProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const d = product.data;
const site = Astro.site!.toString().replace(/\/$/, '');
const url = `${site}${productUrl(product)}`;
const category = d.category ? await getEntry('categories', d.category) : undefined;
const service = d.service ? await getEntry('services', d.service) : undefined;
const { Content } = await render(product);

const imgs = productImages(product);
const main = imgs[0];
const rest = imgs.slice(1);
const thumb = main ? await getImage({ src: main, width: 160, format: 'webp' }) : undefined;
const ogImg = main ? await getImage({ src: main, width: 1200, format: 'jpeg' }) : undefined;

// كلمات البحث الرئيسية لكل قسم (الأعلى بحثًا) — تُستعمل في فقرة الربط أسفل الوصف
const headTerms: Record<string, [string, string]> = {
  'kanab-zawiya': ['كنب زاوية', 'قنفات زاوية'],
  'kanab-diwaniya': ['كنب ديوانية', 'قنفات ديوانية'],
  'kanab-modern': ['كنب مودرن', 'قنفات مودرن'],
  'atqam-kanab': ['أطقم كنب', 'أطقم قنفات'],
  'majalis-arabiya': ['مجالس عربية', 'جلسات عربية'],
  'kanab-classic': ['كنب كلاسيك', 'قنفات كلاسيك'],
  'kanab-amriki': ['كنب امريكي', 'قنفات امريكي'],
};
const terms = category ? headTerms[category.id] : undefined;

const related = (await publishedProducts())
  .filter((p) => p.id !== product.id && ((d.category && p.data.category === d.category) || (d.service && p.data.service === d.service)))
  .slice(0, 4);

const specs = [
  d.priceUnit === 'meter' ? ['طريقة التسعير', 'بالمتر الطولي'] : null,
  d.seats ? ['عدد المقاعد', String(d.seats)] : null,
  d.width ? ['الطول', `${d.width} سم`] : null,
  d.depth ? ['العمق', `${d.depth} سم`] : null,
  d.height ? ['الارتفاع', `${d.height} سم`] : null,
  d.fabric ? ['القماش', d.fabric] : null,
  d.colors.length ? ['الألوان المتاحة', d.colors.join('، ')] : null,
].filter(Boolean) as [string, string][];

const crumbs = [
  { name: 'الرئيسية', href: '/' },
  category
    ? { name: category.data.title, href: `/${category.id}/` }
    : service
      ? { name: service.data.title, href: `/${service.id}/` }
      : { name: 'كل المنتجات', href: '/shop/' },
  { name: d.title, href: productUrl(product) },
];
---
<BaseLayout
  title={d.seoTitle || d.title}
  description={d.description || `${d.title}${typeof d.price === 'number' && d.price > 0 ? ` بسعر ${formatKWD(d.price)}` : ''} من معرض قنفات الضجيج في مجمع كتارا، الكويت. اطلب عبر واتساب.`}
  ogImage={ogImg?.src}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: `${site}${c.href}` }))}
  product={{
    name: d.title,
    url,
    image: ogImg ? new URL(ogImg.src, site).toString() : undefined,
    description: d.description || undefined,
    price: d.price,
    inStock: d.inStock,
    perMeter: d.priceUnit === 'meter',
    shipping: !d.service,
  }}
>
  <section class="container-page pt-8">
    <Breadcrumbs items={crumbs} />
    <div class="mt-5 grid gap-8 lg:grid-cols-2">
      <div class="space-y-3">
        {main && (
          <Image src={main} alt={productAlt(product)} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full rounded-xl border border-line object-cover" loading="eager" fetchpriority="high" />
        )}
        {rest.length > 0 && (
          <div class="grid grid-cols-3 gap-3">
            {rest.map((g, i) => <Image src={g} alt={`${d.title} — صورة ${i + 2}`} widths={[240, 480]} sizes="33vw" class="aspect-square w-full rounded-lg object-cover" />)}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold leading-snug">{d.title}</h1>
        {typeof d.price === 'number' && d.price > 0
          ? <p class="mt-3 text-2xl font-bold">{formatKWD(d.price)}<span class="text-base font-normal text-muted">{unitLabel(d.priceUnit)}</span></p>
          : <p class="mt-3 text-muted">{d.priceNote || 'السعر عبر واتساب'}</p>}
        {typeof d.price === 'number' && d.price > 0 && d.priceNote && <p class="text-sm text-muted">{d.priceNote}</p>}
        {d.priceUnit === 'meter' && <p class="text-sm text-muted">السعر للمتر الطولي من الكنب، ويُحسب الإجمالي حسب مقاس مكانك.</p>}
        <p class="mt-2 text-sm font-semibold text-accent">{d.inStock ? 'متوفر في المعرض' : 'تفصيل حسب الطلب في مشغلنا'}</p>
        {!d.service && <p class="text-sm text-muted">التوصيل متوفر لكل مناطق الكويت برسم ثابت {business.deliveryFeeKWD} د.ك للنقلة الواحدة.</p>}

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            class="btn btn-dark"
            data-add-to-cart
            data-id={product.id}
            data-title={d.title}
            data-price={typeof d.price === 'number' && d.price > 0 ? String(d.price) : ''}
            data-url={url}
            data-image={thumb?.src || ''}
            data-unit={d.priceUnit}
          >أضف إلى السلة</button>
          <a class="btn btn-wa" href={waProduct(d.title, url)} target="_blank" rel="noopener">اسأل عن هذا المنتج عبر واتساب</a>
        </div>

        {specs.length > 0 && (
          <dl class="mt-8 divide-y divide-line rounded-xl border border-line bg-white">
            {specs.map(([k, v]) => <div class="flex justify-between gap-4 p-3"><dt class="text-muted">{k}</dt><dd class="font-semibold">{v}</dd></div>)}
          </dl>
        )}
        <div class="prose-ar mt-6"><Content /></div>
        {service ? (
          <p class="mt-6 rounded-xl bg-sand p-4 text-sm leading-7">
            هذا العمل من خدمة <a class="font-semibold underline" href={`/${service.id}/`}>{service.data.title} في الكويت</a> من مشغل قنفات الضجيج بالضجيج.
            شاهد أيضًا <a class="underline" href="/tafseel-kanab/">تفصيل كنب وقنفات حسب المقاس</a>.
          </p>
        ) : category && terms ? (
          <p class="mt-6 rounded-xl bg-sand p-4 text-sm leading-7">
            من قسم <a class="font-semibold underline" href={`/${category.id}/`}>{terms[0]} و{terms[1]}</a> في الكويت.
            كل الكنب عندنا <a class="underline" href="/tafseel-kanab/">تفصيل حسب المقاس</a> في مشغلنا بالضجيج، والسعر بالمتر شامل القماش.
          </p>
        ) : null}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container-page mt-14">
      <h2 class="text-2xl font-bold">{terms ? `${terms[0]} مشابه` : service ? `أعمال ${service.data.title} أخرى` : 'منتجات مشابهة'}</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </section>
  )}
</BaseLayout>
