---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { publishedProducts } from '../lib/catalog';
import { approvedReviews, ratingSummary, stars, dateAr, REVIEWS_PATH } from '../lib/reviews';

const site = Astro.site!.toString().replace(/\/$/, '');
const reviews = await approvedReviews();
const summary = ratingSummary(reviews);
const products = (await publishedProducts()).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ar'));
const titleOf = new Map(products.map((p) => [p.id, p.data.title]));
const crumbs = [{ name: 'الرئيسية', href: '/' }, { name: 'آراء العملاء', href: REVIEWS_PATH }];
---
<BaseLayout
  title={`آراء العملاء ومراجعاتهم | ${business.name}`}
  description={`مراجعات عملاء ${business.name} الحقيقية عن تفصيل الكنب وتنجيده وتصليحه في مشغلنا بالضجيج، الكويت. اكتب مراجعتك وأرسلها عبر واتساب.`}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: `${site}${c.href}` }))}
>
  <section class="container-page pt-8 pb-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-3 text-3xl font-bold">آراء عملاء قنفات الضجيج</h1>
    <p class="mt-3 max-w-3xl text-muted">كل المراجعات هنا من عملاء حقيقيين أرسلوها لنا بعد استلام الكنب، وننشرها كما كتبوها.</p>
    {summary && <p class="mt-3 text-lg"><span class="text-accent" aria-hidden="true">{stars(summary.average)}</span> {summary.average} من 5 — {summary.count} {summary.count === 1 ? 'مراجعة' : 'مراجعات'}</p>}

    {reviews.length > 0 && (
      <ul class="mt-6 grid max-w-4xl gap-3 md:grid-cols-2">
        {reviews.map((r) => (
          <li class="rounded-xl border border-line bg-white p-4">
            <p class="text-accent" aria-label={`${r.data.rating} من 5`}>{stars(r.data.rating)}</p>
            <p class="mt-2 leading-7">{r.data.text}</p>
            {r.data.product && titleOf.has(r.data.product) && (
              <p class="mt-2 text-sm"><a class="underline" href={`/products/${r.data.product}/`}>{titleOf.get(r.data.product)}</a></p>
            )}
            <p class="mt-1 text-sm text-muted">{r.data.name}{r.data.area ? ` — ${r.data.area}` : ''} · {dateAr(r.data.date)}</p>
          </li>
        ))}
      </ul>
    )}

    <div id="form" class="mt-10 max-w-xl rounded-xl border border-line bg-white p-5">
      <h2 class="text-xl font-bold">اكتب مراجعتك</h2>
      <p class="mt-1 text-sm text-muted">تُرسل مراجعتك إلينا عبر واتساب، ونراجعها ثم ننشرها في الموقع.</p>
      <form id="review-form" class="mt-4 space-y-4" data-wa={business.whatsapp} data-site={site}>
        <fieldset>
          <legend class="font-semibold">التقييم</legend>
          <div class="mt-2 flex flex-row-reverse justify-end gap-1 text-3xl" dir="ltr">
            {[5, 4, 3, 2, 1].map((n) => (
              <label class="cursor-pointer">
                <input class="sr-only peer" type="radio" name="rating" value={n} required />
                <span class="star text-line" data-n={n} aria-label={`${n} من 5`}>★</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="block">
          <span class="font-semibold">اسمك</span>
          <input name="name" required maxlength="40" class="mt-1 w-full rounded-lg border border-line p-2" />
        </label>
        <label class="block">
          <span class="font-semibold">المنطقة (اختياري)</span>
          <input name="area" maxlength="30" class="mt-1 w-full rounded-lg border border-line p-2" />
        </label>
        <label class="block">
          <span class="font-semibold">المنتج أو العمل (اختياري)</span>
          <select name="product" class="mt-1 w-full rounded-lg border border-line bg-white p-2">
            <option value="">— بدون —</option>
            {products.map((p) => <option value={p.id}>{p.data.title}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="font-semibold">رأيك</span>
          <textarea name="text" required minlength="10" maxlength="600" rows="4" class="mt-1 w-full rounded-lg border border-line p-2"></textarea>
        </label>
        <button type="submit" class="btn btn-wa w-full">أرسل المراجعة عبر واتساب</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .star.on { color: #d4a017; }
</style>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (form) {
    const select = form.querySelector('select[name="product"]') as HTMLSelectElement;
    const p = new URLSearchParams(location.search).get('p');
    if (p && [...select.options].some((o) => o.value === p)) select.value = p;

    const paint = () => {
      const v = Number((form.querySelector('input[name="rating"]:checked') as HTMLInputElement | null)?.value || 0);
      form.querySelectorAll<HTMLElement>('.star').forEach((s) => s.classList.toggle('on', Number(s.dataset.n) <= v));
    };
    form.addEventListener('change', paint);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const rating = Number(f.get('rating'));
      const productId = String(f.get('product') || '');
      const productTitle = productId ? select.selectedOptions[0].text : '';
      const lines = [
        'مراجعة جديدة لموقع قنفات الضجيج',
        `التقييم: ${'★'.repeat(rating)}${'☆'.repeat(5 - rating)} (${rating} من 5)`,
        `الاسم: ${String(f.get('name')).trim()}`,
        ...(String(f.get('area') || '').trim() ? [`المنطقة: ${String(f.get('area')).trim()}`] : []),
        ...(productId ? [`المنتج: ${productTitle}`, `${form.dataset.site}/products/${productId}/`] : []),
        `الرأي: ${String(f.get('text')).trim()}`,
      ];
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
    });
  }
</script>
