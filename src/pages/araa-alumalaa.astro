---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { publishedProducts } from '../lib/catalog';
import { approvedReviews, ratingSummary, stars, REVIEWS_PATH } from '../lib/reviews';
import ReviewList from '../components/ReviewList.astro';
import ReviewForm from '../components/ReviewForm.astro';

const site = Astro.site!.toString().replace(/\/$/, '');
const reviews = await approvedReviews();
const summary = ratingSummary(reviews);
const products = (await publishedProducts()).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ar'));
const titleOf = new Map(products.map((p) => [p.id, p.data.title]));
const crumbs = [{ name: 'الرئيسية', href: '/' }, { name: 'آراء العملاء', href: REVIEWS_PATH }];
---
<BaseLayout
  hideReviews
  title={`آراء العملاء ومراجعاتهم | ${business.name}`}
  description={`مراجعات عملاء ${business.name} الحقيقية عن تفصيل الكنب وتنجيده وتصليحه في مشغلنا بالضجيج، الكويت. اكتب رأيك وينشر مباشرة.`}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: `${site}${c.href}` }))}
>
  <section class="container-page pt-8 pb-12">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-3 text-3xl font-bold">آراء عملاء قنفات الضجيج</h1>
    <p class="mt-3 max-w-3xl text-muted">كل المراجعات هنا من عملاء حقيقيين، وتُنشر كما كتبوها.</p>
    {summary && <p class="mt-3 text-lg"><span class="text-accent" aria-hidden="true">{stars(summary.average)}</span> {summary.average} من 5 — {summary.count} {summary.count === 1 ? 'مراجعة' : 'مراجعات'}</p>}

    <ReviewList reviews={reviews} titles={titleOf} />

    <div id="form" class="mt-10 max-w-xl rounded-xl border border-line bg-white p-5">
      <h2 class="text-xl font-bold">اكتب رأيك</h2>
      <ReviewForm />
    </div>
  </section>
</BaseLayout>
