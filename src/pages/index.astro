---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQ from '../components/FAQ.astro';
import { business, fullAddress, services } from '../data/business';
import { waGeneral } from '../data/whatsapp';
import { Image } from 'astro:assets';
import { publishedProducts, categoriesWithProducts, productsForService, priceFrom, priceTextAr, productImages, productAlt } from '../lib/catalog';

const products = (await publishedProducts()).slice(0, 8);
// صورة الواجهة: أول صورة لأحدث منتج — صورة شغل حقيقي من المعرض/المشغل
const heroProduct = products.find((p) => productImages(p).length > 0);
const heroImage = heroProduct ? productImages(heroProduct)[0] : undefined;
const heroAlt = heroProduct ? productAlt(heroProduct) : '';
const cats = await categoriesWithProducts();
const tafseelList = await productsForService('tafseel-kanab');
const tanjeedList = await productsForService('tanjeed-kanab');
const tafseelFrom = priceFrom(tafseelList);
const tanjeedFrom = priceFrom(tanjeedList);

// إجابات من معلومات مؤكدة فقط
const faqs = [
  { question: `أين يقع معرض ${business.name}؟`, answer: `في ${fullAddress}.` },
  { question: 'ما الخدمات التي تقدمونها؟', answer: 'بيع كنب وقنفات جاهزة من المعرض، وتفصيل الكنب حسب المقاس، وتنجيد وتلبيس الكنب القديم بالقماش، وتصليح أرجل الكنب وتغيير الإسفنج. كل الأعمال في مشغلنا بالضجيج.' },
  { question: 'كيف أطلب من الموقع؟', answer: `أضف المنتجات إلى السلة ثم اضغط «أرسل الطلب عبر واتساب»، أو راسلنا مباشرة على واتساب ${business.phone}.` },
  { question: 'هل الأسعار بالدينار الكويتي؟', answer: 'نعم، كل الأسعار في الموقع بالدينار الكويتي.' },
  ...(tafseelFrom || tanjeedFrom
    ? [{
        question: 'كم سعر تفصيل وتنجيد الكنب؟',
        answer: [
          tafseelFrom && `تفصيل الكنب حسب المقاس ${priceTextAr(tafseelList)} الطولي شامل القماش`,
          tanjeedFrom && `وتنجيد الكنب بالقماش ${priceTextAr(tanjeedList)} الطولي شامل القماش`,
        ].filter(Boolean).join('، ') + '. الكراسي المفردة سعرها بالاتفاق.',
      }]
    : []),
];
---
<BaseLayout
  title={`كنب وقنفات في الكويت — ${business.name}، معرض ومشغل`}
  description={`معرض ومشغل كنب وقنفات في مجمع كتارا بالضجيج، الكويت: تفصيل كنب حسب المقاس ${priceTextAr(tafseelList)} وتنجيد ${priceTextAr(tanjeedList)} شامل القماش، وكنب جاهز. اطلب عبر واتساب ${business.phone}.`}
  faqs={faqs}
  alternate="/en/"
>
  <section class="container-page pt-4 md:pt-8">
    <div class="hero relative overflow-hidden rounded-2xl bg-ink">
      {heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1152px) 1120px, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
      <div class="relative flex h-full flex-col justify-end p-5 md:p-10">
        <h1 class="max-w-2xl text-3xl font-bold leading-snug text-white text-balance md:text-5xl md:leading-tight">قنفات وكنب في الكويت من معرضنا ومشغلنا بالضجيج</h1>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="btn btn-wa" href={waGeneral()} target="_blank" rel="noopener">اطلب عبر واتساب</a>
          <a class="btn btn-light" href="/shop/">تصفح الكنب والقنفات</a>
        </div>
      </div>
    </div>
    <p class="mt-5 max-w-3xl text-muted">{business.description}</p>
  </section>

  {cats.length > 0 && (
    <section class="container-page mt-8">
      <h2 class="sr-only">الأقسام</h2>
      <div class="chips -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:px-0">
        {cats.map((c) => <a class="btn btn-line shrink-0 px-4 py-1.5 text-sm" href={`/${c.id}/`}>{c.data.title}</a>)}
      </div>
    </section>
  )}

  {products.length > 0 && (
    <section class="container-page mt-8">
      <div class="flex items-end justify-between">
        <h2 class="text-2xl font-bold">أحدث الكنب والقنفات</h2>
        <a class="text-sm underline underline-offset-4" href="/shop/">كل المنتجات</a>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
        {products.map((p) => <ProductCard product={p} />)}
      </div>
    </section>
  )}

  <section class="container-page mt-14">
    <h2 class="text-2xl font-bold">خدماتنا</h2>
    <ul class="mt-4 divide-y divide-line border-y border-line md:grid md:grid-cols-4 md:divide-y-0 md:divide-x md:divide-x-reverse">
      {[{ slug: 'maarad-dajeej', title: 'كنب جاهز في المعرض', short: 'كنب وقنفات جاهزة تشاهدها في معرضنا بمجمع كتارا.' }, ...services].map((s) => (
        <li>
          <a href={`/${s.slug}/`} class="group flex items-center justify-between gap-4 py-4 md:h-full md:flex-col md:items-start md:px-5">
            <span>
              <span class="block font-bold group-hover:text-accent">{s.title}</span>
              <span class="mt-0.5 block text-sm text-muted">{s.short}</span>
            </span>
            <svg class="h-5 w-5 shrink-0 text-accent md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page mt-14">
    <div class="rounded-xl border border-line bg-white p-6">
      <h2 class="text-2xl font-bold">زورنا في المعرض</h2>
      <p class="mt-2">{fullAddress}</p>
      <p class="mt-1">الهاتف وواتساب: <a dir="ltr" class="font-semibold" href={`tel:+965${business.phone}`}>{business.phone}</a></p>
      <a class="mt-3 inline-block underline" href="/maarad-dajeej/">تفاصيل المعرض</a>
    </div>
  </section>

  <div class="container-page"><FAQ faqs={faqs} /></div>
</BaseLayout>
